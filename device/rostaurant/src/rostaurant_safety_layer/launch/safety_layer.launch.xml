<?xml version='1.0' ?>

<!--
  safety_layer.launch.xml
  ───────────────────────
  Full safety pipeline (Camera-LiDAR Fusion 3-Zone System).
  파라미터는 src/config/config.yaml (통합 설정) 에서 로드합니다.

      camera_node (UDP Multicast 송신)
               │  UDP 239.255.0.1:5000
               ▼
   child_detection_node (YOLO + LiDAR fusion)
               │  child_safety_zone (String: NORMAL/MONITOR/CAUTION/STOP)
               ├───────────────────────┬──────────────────────────────┐
               ▼                       ▼                              ▼
      safety_layer_node          event_recorder_node            buzzer_node
      cmd_vel_raw →                STOP → 60s 버퍼             (CAUTION/STOP
      CAUTION: 50% 감속              → mp4/csv 저장               경고음)
      STOP: 속도 0
      → /cmd_vel
-->

<launch>
    <!-- 통합 설정 파일 경로 (robot_bringup에서 전달받거나 단독 실행 시 기본값 사용) -->
    <arg name="config"
         default="$(find-pkg-share rostaurant_state_machine)/config/config.yaml"/>
    <arg name="use_sim_time" default="False"/>

    <!-- YOLO 가중치·신뢰도는 launch 인수로 빠르게 덮어쓸 수 있습니다 -->
    <arg name="yolo_model"  default="best.pt"/>
    <arg name="confidence"  default="0.5"/>

    <!-- ── Camera publisher ──────────────────────────────────────────────── -->
    <node pkg="rostaurant_camera" exec="camera_node" name="camera_node"
          output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var config)"/>
    </node>

    <!-- ── Child detection (Camera-LiDAR 3-zone) ────────────────────────── -->
    <node pkg="rostaurant_safety_layer" exec="child_detection_node" name="child_detection_node"
          output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var config)"/>
        <!-- launch 인수로 자주 바꾸는 항목만 덮어쓰기 -->
        <param name="yolo_model"  value="$(var yolo_model)"/>
        <param name="confidence"  value="$(var confidence)"/>
    </node>

    <!-- ── Safety layer ──────────────────────────────────────────────────── -->
    <node pkg="rostaurant_safety_layer" exec="safety_layer_node" name="safety_layer_node"
          output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var config)"/>
    </node>

    <!-- ── Buzzer node ───────────────────────────────────────────────────── -->
    <node pkg="rostaurant_safety_layer" exec="buzzer_node" name="buzzer_node"
          output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var config)"/>
    </node>

    <!-- ── Event recorder ───────────────────────────────────────────────── -->
    <node pkg="rostaurant_safety_layer" exec="event_recorder_node" name="event_recorder_node"
          output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var config)"/>
    </node>

</launch>
