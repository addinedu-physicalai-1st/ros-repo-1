<?xml version='1.0' ?>

<!--
  safety_layer.launch.xml
  ───────────────────────
  Full safety pipeline:

      camera hardware (/dev/videoX)
               │  VideoCapture (네트워크 트래픽 없음)
               ├──────────────────────────────────────────────────────┐
               ▼                                                      ▼
   child_detection_node (YOLO)                         event_recorder_node
               │                                          │  60s rolling buffer
               ▼                                          │  safety_events/
       /child_detected ──────────────────────────────────►│    video.mp4
               │                                          │    lidar.csv
               ▼
      navigation / teleop → /cmd_vel_raw
               │
       safety_layer_node → /safety_stop_event ──────────►event_recorder_node
               │
           /cmd_vel
               │
       robot base controller (pinky_bringup)
-->

<launch>
    <arg name="use_sim_time" default="False"/>

    <!-- Path to the YOLO weights file. Override at launch time as needed. -->
    <arg name="model_path" default="best.pt"/>

    <!-- YOLO confidence threshold (0.0 – 1.0). -->
    <arg name="confidence" default="0.5"/>

    <!-- OpenCV VideoCapture 인덱스 (0 = /dev/video0). -->
    <arg name="camera_index" default="0"/>

    <!-- 초당 캡처 및 추론 횟수. 높을수록 CPU 부하 증가. -->
    <arg name="capture_rate_hz" default="10.0"/>

    <!-- ── Publish_Camera ───────────────────────────────────────────────── -->
    <node pkg="pinky_camera" exec="camera_node" name="camera_node"
          output="screen">
    </node>

    <!-- ── Child detection ───────────────────────────────────────────────── -->
    <!--
      OpenCV VideoCapture로 카메라를 직접 열고 YOLO 추론 결과만
      /child_detected 에 퍼블리시합니다. /image_raw 토픽은 사용하지 않습니다.
    -->
    <node pkg="pinky_safety_layer" exec="child_detection_node" name="child_detection_node"
          output="screen">
        <param name="use_sim_time"     value="$(var use_sim_time)"/>
        <param name="model_path"       value="$(var model_path)"/>
        <param name="confidence"       value="$(var confidence)"/>
        <param name="camera_index"     value="$(var camera_index)"/>
        <param name="capture_rate_hz"  value="$(var capture_rate_hz)"/>
        <!-- 모델의 클래스 레이블이 다르면 아래 줄 주석을 해제하여 덮어씁니다. -->
        <!-- <param name="child_class_names" value="['child', 'person_child']"/> -->
    </node>

    <!-- ── Safety layer ──────────────────────────────────────────────────── -->
    <!--
      Subscribes to /cmd_vel_raw and /child_detected.
      Publishes safe velocity commands to /cmd_vel.
    -->
    <node pkg="pinky_safety_layer" exec="safety_layer_node" name="safety_layer_node"
          output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- ── Event recorder ───────────────────────────────────────────────── -->
    <!--
      /safety_stop_event=True 가 되면:
        1. 직전 60초 버퍼를 video.mp4 로 덤프
        2. live 프레임·라이다를 계속 기록
        3. False 가 되면 video.mp4 닫고 lidar.csv 저장
      camera_index 는 child_detection_node 와 같은 값을 사용하지만
      두 노드가 독립적으로 cap을 엽니다 (USB 멀티 오픈 허용 여부는 드라이버 의존).
      동일 카메라를 공유하려면 별도 카메라 서버 노드를 두는 것을 권장합니다.
    -->
    <node pkg="pinky_safety_layer" exec="event_recorder_node" name="event_recorder_node"
          output="screen">
        <param name="use_sim_time"      value="$(var use_sim_time)"/>
        <param name="camera_index"      value="$(var camera_index)"/>
        <param name="capture_rate_hz"   value="$(var capture_rate_hz)"/>
        <!-- 버퍼 유지 시간(초). 기본 60초. -->
        <!-- <param name="buffer_seconds" value="60.0"/> -->
        <!-- 이벤트 저장 루트 디렉터리. 절대 경로 권장. -->
        <!-- <param name="output_dir"     value="/home/pi/safety_events"/> -->
        <!-- JPEG 압축 품질 (낮을수록 메모리 절약, 화질 저하). -->
        <!-- <param name="jpeg_quality"   value="80"/> -->
    </node>

    <!-- ── Robot base controller ─────────────────────────────────────────── -->
    <!-- <node pkg="pinky_bringup" exec="bringup" name="pinky_bringup">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node> -->

    <!-- ── Navigation / teleop (examples) ───────────────────────────────── -->
    <!--
      All velocity sources must publish to /cmd_vel_raw so commands flow
      through the safety layer before reaching the base controller.

      Teleop example:
        <node pkg="teleop_twist_keyboard" exec="teleop_twist_keyboard"
              name="teleop" output="screen">
            <remap from="cmd_vel" to="cmd_vel_raw"/>
        </node>

      Nav2 example — set in your nav2_params.yaml:
          controller_server:
            ros__parameters:
              cmd_vel_topic: cmd_vel_raw
    -->

</launch>
