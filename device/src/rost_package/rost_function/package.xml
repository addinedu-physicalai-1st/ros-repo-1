<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rost_function</name>
  <version>0.0.0</version>
  <description>
    Restaurant serving robot function execution package.
    rost_state_machine 패키지와 연동하여 각 FSM 상태에서 실제 로봇 동작을 수행하는
    기능 노드들을 제공한다. Nav2 연동 및 배터리 시뮬레이션을 포함한다.
  </description>
  <maintainer email="kyung133851@pinklab.art">pl3</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 런타임 의존성 -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>

  <!-- rost_state_machine 커스텀 메시지 의존성 -->
  <depend>rost_state_machine</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
