<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rost_camera</name>
  <version>0.0.0</version>
  <description>
    Single camera publisher node for Rost Pro robot.
    Opens the camera once and publishes JPEG-compressed frames to /image
    (sensor_msgs/CompressedImage) so that multiple downstream nodes
    (child_detection_node, event_recorder_node, etc.) can share the stream
    without conflicting camera access.
  </description>
  <maintainer email="kyung133851@pinklab.art">pl3</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <!-- opencv-python and numpy are Python-level deps, not ROS packages.
       They are listed here for documentation; install via pip if needed. -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
